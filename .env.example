# Required. Atlas, local, or Coolify MongoDB connection string.
# MONGO_URL also works as an alias.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=

# Optional. Leave empty to dump every database the user can read.
MONGO_DB=

# Host folder where gzip archives are stored.
# On this Mac the drive is not at /media/... — that path is Linux.
# If Coolify/Docker runs on Linux with the disk mounted, use:
BACKUP_HOST_PATH=/media/ashish/External1/db_backup_daily
# If you run Docker on this Mac instead, use the /Volumes path, for example:
# BACKUP_HOST_PATH=/Volumes/External1/db_backup_daily

BACKUP_PREFIX=mongodb
BACKUP_INTERVAL_HOURS=24
RUN_ON_START=true
TZ=Asia/Kolkata
